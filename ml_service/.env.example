# Copy to ml_service/.env (git-ignored) and fill in. Real environment variables override this file.

# Required for training (news sentiment + LLM alpha formulas)
POLYGON_API_KEY=
GROQ_API_KEY=

# Shared secret the Go backend sends as X-Internal-Token. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_INTERNAL_TOKEN=

# Optional overrides (defaults shown)
# MODEL_DIR=models
# JOBS_DB_PATH=models/jobs.db
# LOOKBACK_DAYS=730
# NEWS_BATCH_SIZE=1000
# NEWS_SLEEP_TIME=12
# RELATED_COMPANIES_SLEEP_TIME=15
# MAX_RELATED_COMPANIES=5
# WINDOW_SIZE=30
# ENSEMBLE_SIZE=3
# NUM_EPOCHS=100
# MC_SAMPLES=10
