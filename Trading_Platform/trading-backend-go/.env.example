# Copy to .env and fill in. run.ps1 loads this file before starting the server.

# Must be at least 32 characters (HS256 needs a 256-bit key).
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# https://finnhub.io  — stock prices, symbol search and news
FINNHUB_API_KEY=your_finnhub_api_key

# https://www.alphavantage.co  — historical daily candles for stocks
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Optional overrides; the defaults match docker-compose.yml.
# DATABASE_URL=postgres://dev:dev@localhost:5432/trading?sslmode=disable
# REDIS_ADDR=localhost:6379
# PORT=8080

# If you already run PostgreSQL or Redis natively, their ports collide with the
# containers. Windows lets both processes listen on the same port, so which one
# you reach is non-deterministic and you get confusing auth failures. Publish
# the containers on free ports instead and point the app at them:
# POSTGRES_HOST_PORT=55432
# DATABASE_URL=postgres://dev:dev@127.0.0.1:55432/trading?sslmode=disable
# REDIS_HOST_PORT=6380
# REDIS_ADDR=127.0.0.1:6380

# ML prediction service (ml_service in the Trading_Python repo). Must equal
# ML_INTERNAL_TOKEN in ml_service/.env; leave empty to disable predictions (503).
ML_INTERNAL_TOKEN=
# ML_SERVICE_URL=http://127.0.0.1:8000
# ML_TIMEOUT_MS=10000

# Set to false to skip the startup symbol seeding or the live price streams.
# SEED_SYMBOLS=true
# STREAM_MARKET_DATA=true
